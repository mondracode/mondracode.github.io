---
import Home from "../layouts/Homepage.astro";
import History from "../components/History.astro";
import Skills from "../components/Skills.astro";

import work from "../content/es/work.json";
import academy from "../content/es/academy.json";
import skills from "../content/es/skills.json";
import summary from "../content/es/summary.json";
---

<Home>
    <header class="site-header">
        <h1>Santiago Mondragón Gómez</h1>
        <div class="site-meta">
            <span class="tagline">ingeniero de software</span>
            <div class="contact-links">
                <a href="https://www.linkedin.com/in/mondracode/">linkedin</a>
                <a href="https://github.com/mondracode">github</a>
                <a href="mailto:mondracode.dev@gmail.com"
                    >mondracode.dev@gmail.com</a
                >
            </div>
        </div>
    </header>

    <div class="summary">
        <p class="summary-body">
            {summary.body.before}<span class="summary-em">{summary.body.emphasis}</span><br class="summary-break" />{summary.body.after}
        </p>
    </div>

    <History src={work} />
    <Skills src={skills} />
    <History src={academy} />
</Home>

<style>
    .summary {
        padding: 2rem 0 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .summary-body {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--color-text);
    }

    @media (min-width: 721px) {
        .summary-body {
            max-width: 52ch;
        }
    }

    .summary-break {
        display: none;
    }

    @media (min-width: 721px) {
        .summary-break {
            display: block;
        }
    }

    .summary-em {
        color: var(--color-accent);
    }
</style>
