---
interface Props {
  src: {
    heading: string;
    categories: { label: string; items: string }[];
    languagesHeading: string;
    languages: { label: string; level: string }[];
  };
  id: string;
}

const { src, id } = Astro.props;
---

<section class="resume-section" aria-labelledby={`${id}-heading`}>
  <h2 class="section-heading" id={`${id}-heading`}>{src.heading}</h2>
  <dl class="skills-grid">
    {src.categories.map((c) => (
      <div class="skill-row">
        <dt class="skill-label">{c.label}</dt>
        <dd class="skill-items">{c.items}</dd>
      </div>
    ))}
  </dl>
</section>

<section class="resume-section languages-section" aria-labelledby={`${id}-languages-heading`}>
  <h2 class="section-heading" id={`${id}-languages-heading`}>{src.languagesHeading}</h2>
  <dl class="lang-row">
    {src.languages.map((l) => (
      <div class="lang-entry">
        <dt class="skill-label">{l.label}</dt>
        <dd class="skill-items">{l.level}</dd>
      </div>
    ))}
  </dl>
</section>
