---
import '../styles/global.css';
import '../styles/layout.css';

const year = new Date().getFullYear();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Santiago Mondragón Gómez</title>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('lang');
        var lang = stored || (navigator.language.startsWith('es') ? 'es' : 'en');
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang;
      })();
    </script>
  </head>
  <body>
    <div class="frame">
      <main>
        <slot />
      </main>
      <footer>
        <div class="footer-inner">
          <div class="footer-left">
            <span class="footer-name">Santiago Mondragón Gómez</span>
            <span class="footer-year">{year}</span>
          </div>
          <div class="footer-links">
            <a href="https://www.linkedin.com/in/mondracode/">linkedin</a>
            <a href="https://github.com/mondracode">github</a>
            <a href="mailto:mondracode.dev@gmail.com">email</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
