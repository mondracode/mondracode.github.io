---
import type { History } from '../types/history';

interface Props {
  src: History;
  id: string;
  compact?: boolean;
}

const { src: data, id, compact = false } = Astro.props;
---

<section class:list={['resume-section', 'history-section', { 'history-section--compact': compact }]} aria-labelledby={`${id}-heading`}>
  <h2 class="section-heading" id={`${id}-heading`}>{data.heading}</h2>
  {
    data.experiences.map((e, index) => (
      <article class="exp" aria-labelledby={`${id}-${index}`}>
        <div class="exp-name">
          <h3 id={`${id}-${index}`}>{e.name}</h3>
          {e.location && <p class="exp-location">{e.location}</p>}
        </div>
        {e.positions.map((p) => (
          <div class="pos">
            <div class="pos-title">
              <h4 class="pos-role">{p.title}</h4>
              <p class="pos-date">{p.timespan}</p>
            </div>
            {p.description.length > 0 && (
              <ul>
                {p.description.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </article>
    ))
  }
</section>
