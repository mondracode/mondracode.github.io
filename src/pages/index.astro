---
import Home from "../layouts/Homepage.astro";
import History from "../components/History.astro";
import Skills from "../components/Skills.astro";

import work from "../content/es/work.json";
import academy from "../content/es/academy.json";
import skills from "../content/es/skills.json";
import summary from "../content/es/summary.json";
---

<Home>
    <header class="site-header">
        <h1>Santiago Mondragón Gómez</h1>
        <div class="site-meta">
            <span class="tagline">ingeniero de software</span>
            <div class="contact-links">
                <a href="https://www.linkedin.com/in/mondracode/">linkedin</a>
                <a href="https://github.com/mondracode">github</a>
                <a href="mailto:mondracode.dev@gmail.com"
                    >mondracode.dev@gmail.com</a
                >
            </div>
        </div>
    </header>

    <div class="summary">
        <p class="summary-lead">
            {summary.lead.before}<span class="summary-em"
                >{summary.lead.emphasis}</span
            >{summary.lead.after}
        </p>
        <p class="summary-body">{summary.body}</p>
    </div>

    <History src={work} />
    <Skills src={skills} />
    <History src={academy} />
</Home>

<style>
    .summary {
        padding: 1rem 0 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .summary-lead {
        font-weight: 550;
        font-size: 1.25rem;
        color: var(--color-text);
    }

    .summary-em {
        color: var(--color-accent);
    }

    .summary-body {
        line-height: 1.5;
        font-size: 0.9rem;
        color: var(--color-text);
        font-style: italic;
    }
</style>
