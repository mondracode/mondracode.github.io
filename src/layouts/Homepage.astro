---
import '../styles/global.css';
import '../styles/layout.css';

const year = new Date().getFullYear();
const title = 'Santiago Mondragón Gómez — Software Engineer';
const description = 'Software engineer focused on Go backends and React applications. Currently at Auvik, with experience modernizing systems serving millions of users around the world.';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        var stored;
        try {
          stored = localStorage.getItem('lang');
        } catch (_) {
          // Language selection still works when browser storage is unavailable.
        }
        var lang = stored === 'es' || stored === 'en'
          ? stored
          : (navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en');
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang;
      })();
    </script>
  </head>
  <body>
    <div class="frame">
      <main>
        <slot />
      </main>
      <footer>
        <div class="footer-inner">
          <div class="footer-left">
            <span class="footer-name">Santiago Mondragón Gómez</span>
            <span class="footer-year">{year}</span>
          </div>
          <div class="footer-links">
            <a href="https://www.linkedin.com/in/mondracode/">linkedin</a>
            <a href="https://github.com/mondracode">github</a>
            <a href="mailto:mondracode.dev@gmail.com">email</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
