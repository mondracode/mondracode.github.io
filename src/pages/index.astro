---
import Home from "../layouts/Homepage.astro";
import History from "../components/History.astro";
import Skills from "../components/Skills.astro";

import workEs from "../content/es/work.json";
import academyEs from "../content/es/academy.json";
import skillsEs from "../content/es/skills.json";
import summaryEs from "../content/es/summary.json";

import workEn from "../content/en/work.json";
import academyEn from "../content/en/academy.json";
import skillsEn from "../content/en/skills.json";
import summaryEn from "../content/en/summary.json";
---

<Home>
    <header class="site-header">
        <div class="site-identity">
            <h1>Santiago Mondragón Gómez</h1>
        </div>
        <div class="lang-toggle" role="group" aria-label="Idioma / Language">
            <button type="button" id="btn-es" class="lang-btn" lang="es" aria-label="Español" aria-pressed="true">ES</button>
            <span class="lang-sep-toggle" aria-hidden="true">/</span>
            <button type="button" id="btn-en" class="lang-btn" lang="en" aria-label="English" aria-pressed="false">EN</button>
        </div>
        <div class="site-meta">
            <p class="tagline" id="tagline-es" lang="es">ingeniero de software</p>
            <p class="tagline" id="tagline-en" lang="en">software engineer</p>
            <nav class="contact-links" aria-label="Contacto / Contact">
                <a href="https://www.linkedin.com/in/mondracode/">linkedin</a>
                <a href="https://github.com/mondracode">github</a>
                <a href="mailto:mondracode.dev@gmail.com">mondracode.dev@gmail.com</a>
            </nav>
        </div>
    </header>

    <div id="content-es" lang="es">
        <div class="summary">
            <p class="summary-body">
                {summaryEs.body.before}<a class="summary-em" href="https://www.auvik.com/" target="_blank" rel="noopener noreferrer"
                    >{summaryEs.body.emphasis}</a
                >{summaryEs.body.after}
            </p>
        </div>
        <History src={workEs} id="experience-es" />
        <History src={academyEs} id="education-es" compact />
        <Skills src={skillsEs} id="skills-es" />
    </div>

    <div id="content-en" lang="en">
        <div class="summary">
            <p class="summary-body">
                {summaryEn.body.before}<a class="summary-em" href="https://www.auvik.com/" target="_blank" rel="noopener noreferrer"
                    >{summaryEn.body.emphasis}</a
                >{summaryEn.body.after}
            </p>
        </div>
        <History src={workEn} id="experience-en" />
        <History src={academyEn} id="education-en" compact />
        <Skills src={skillsEn} id="skills-en" />
    </div>
</Home>

<script>
    function setLang(lang: 'es' | 'en') {
        try {
            localStorage.setItem('lang', lang);
        } catch {
            // Keep the toggle usable even when storage is blocked.
        }
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang;

        document.getElementById('btn-es')!.setAttribute('aria-pressed', String(lang === 'es'));
        document.getElementById('btn-en')!.setAttribute('aria-pressed', String(lang === 'en'));
    }

    document.getElementById('btn-es')!.addEventListener('click', () => setLang('es'));
    document.getElementById('btn-en')!.addEventListener('click', () => setLang('en'));

    setLang(document.documentElement.dataset.lang === 'en' ? 'en' : 'es');
</script>
